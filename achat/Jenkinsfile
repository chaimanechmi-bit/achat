pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timestamps()
    }

    environment {
        IMAGE_NAME = 'achat-app'
    }

    stages {
        stage('Checkout depuis Git') {
            steps {
                checkout scm
                echo 'Code récupéré depuis GitHub.'
            }
        }

        stage('Verification du projet') {
            steps {
                bat 'dir'
                dir('achat') {
                    bat 'dir'
                }
            }
        }

        stage('Build Maven') {
            steps {
                dir('achat') {
                    bat 'mvn clean compile'
                }
            }
        }

        stage('Tests avec JaCoCo') {
            steps {
                dir('achat') {
                    bat 'mvn test -DfailIfNoTests=false'
                }
            }
        }

        stage('Analyse SonarQube') {
            steps {
                dir('achat') {
                    echo 'Analyse de la qualite du code avec SonarQube...'
                    withSonarQubeEnv('SonarQube') {
                        bat '''
                            mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar ^
                            -Dsonar.projectKey=achat ^
                            -Dsonar.projectName=achat
                        '''
                    }
                }
            }
        }

        stage('Package') {
            steps {
                dir('achat') {
                    bat 'mvn package -DskipTests'
                }
            }
        }

        stage('Publish to Nexus') {
            steps {
                dir('achat') {
                    echo 'Publication de l artifact dans Nexus...'
                    configFileProvider([
                        configFile(
                            fileId: 'nexus-maven-settings',
                            variable: 'MAVEN_SETTINGS'
                        )
                    ]) {
                        bat 'mvn deploy -s %MAVEN_SETTINGS% -DskipTests'
                    }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('achat') {
                    echo 'Construction de l image Docker...'
                    bat 'docker build -t %IMAGE_NAME% .'
                }
            }
        }

        stage('Run Application with Docker Compose') {
            steps {
                dir('achat') {
                    echo 'Arret des anciens conteneurs...'
                    bat 'docker compose down --remove-orphans || exit 0'

                    echo 'Demarrage de PostgreSQL, pgAdmin et application...'
                    bat 'docker compose up -d'

                    echo 'Verification des conteneurs...'
                    bat 'docker ps'
                }
            }
        }
    }

    post {
        success {
            echo 'success.'
        }

        failure {
            echo 'failure.'
        }

        always {
            archiveArtifacts artifacts: 'achat/target/*.jar',
                             fingerprint: true,
                             allowEmptyArchive: true

            junit allowEmptyResults: true,
                  testResults: 'achat/target/surefire-reports/*.xml'
        }
    }
}