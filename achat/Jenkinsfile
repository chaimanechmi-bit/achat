pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timestamps()
    }

    environment {
        IMAGE_NAME = 'achat-app'
        IMAGE_TAG  = 'latest'
        FULL_IMAGE = 'achat-app:latest'
    }

    stages {

        // ─────────────────────────────────────────
        // 1. CHECKOUT
        // ─────────────────────────────────────────
        stage('Checkout depuis Git') {
            steps {
                checkout scm
                echo 'Code récupéré depuis GitHub.'
            }
        }

        // ─────────────────────────────────────────
        // 2. INJECT .ENV
        // ─────────────────────────────────────────
        stage('Load ENV securely') {
            steps {
                dir('achat') {
                    withCredentials([file(credentialsId: 'achat-env', variable: 'ENV_FILE')]) {
                        bat '''
                        echo ==== LOADING .ENV FROM JENKINS CREDENTIALS ====
                        if exist .env del .env
                        copy "%ENV_FILE%" .env
                        echo .env injected successfully
                        '''
                    }
                }
            }
        }

        // ─────────────────────────────────────────
        // 3. VERIFICATION
        // ─────────────────────────────────────────
        stage('Verification du projet') {
            steps {
                bat 'dir'
                dir('achat') {
                    bat 'dir'
                }
            }
        }

        // ─────────────────────────────────────────
        // 4. BUILD
        // ─────────────────────────────────────────
        stage('Build Maven') {
            steps {
                dir('achat') {
                    bat 'mvn clean compile'
                }
            }
        }

        // ─────────────────────────────────────────
        // 5. TESTS
        // ─────────────────────────────────────────
        stage('Tests avec JaCoCo') {
            steps {
                dir('achat') {
                    bat 'mvn test -DfailIfNoTests=false'
                }
            }
        }

        // ─────────────────────────────────────────
        // 6. OWASP DEPENDENCY CHECK
        //    FIX : suppression de image.tar avant
        //    le scan + --disableArchive pour éviter
        //    l'erreur InvalidPathException Windows
        // ─────────────────────────────────────────
        stage('OWASP Dependency Check') {
            steps {
                dir('achat') {
                    script {
                        def dcHome = tool 'owasp-dc'

                        bat """
                        echo ==== NETTOYAGE AVANT SCAN OWASP ====
                        if exist image.tar del /f image.tar

                        if not exist reports mkdir reports

                        ${dcHome}\\bin\\dependency-check.bat ^
                            --project achat-app ^
                            --scan . ^
                            --format HTML ^
                            --out reports ^
                            --disableArchive ^
                            --disableCentral ^
                            --noupdate ^
                            --nvdMaxRetryCount 2
                        """
                    }
                }
            }
            post {
                always {
                    publishHTML(target: [
                        allowMissing         : true,
                        alwaysLinkToLastBuild: true,
                        keepAll              : true,
                        reportDir            : 'achat/reports',
                        reportFiles          : 'dependency-check-report.html',
                        reportName           : 'OWASP Dependency Check'
                    ])
                }
            }
        }

        // ─────────────────────────────────────────
        // 7. SONARQUBE
        // ─────────────────────────────────────────
        stage('Analyse SonarQube') {
            steps {
                dir('achat') {
                    withSonarQubeEnv('SonarQube') {
                        bat '''
                        mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar ^
                            -Dsonar.projectKey=achat ^
                            -Dsonar.projectName=achat
                        '''
                    }
                }
            }
        }

        // ─────────────────────────────────────────
        // 8. PACKAGE
        // ─────────────────────────────────────────
        stage('Package') {
            steps {
                dir('achat') {
                    bat 'mvn package -DskipTests'
                }
            }
        }

        // ─────────────────────────────────────────
        // 9. TRIVY FS SCAN
        // ─────────────────────────────────────────
        stage('Trivy FS Scan') {
            steps {
                dir('achat') {
                    bat '''
                    docker run --rm ^
                        -v "%cd%:/project" ^
                        -v trivy-cache:/root/.cache/ ^
                        aquasec/trivy fs ^
                        --no-progress ^
                        --scanners vuln,secret ^
                        /project
                    '''
                }
            }
        }

        // ─────────────────────────────────────────
        // 10. NEXUS
        // ─────────────────────────────────────────
        stage('Publish to Nexus') {
            steps {
                dir('achat') {
                    configFileProvider([
                        configFile(
                            fileId  : 'nexus-maven-settings',
                            variable: 'MAVEN_SETTINGS'
                        )
                    ]) {
                        bat 'mvn deploy -s %MAVEN_SETTINGS% -DskipTests'
                    }
                }
            }
        }

        // ─────────────────────────────────────────
        // 11. BUILD DOCKER IMAGE
        // ─────────────────────────────────────────
        stage('Build Docker Image') {
            steps {
                dir('achat') {
                    bat 'docker build -t %FULL_IMAGE% .'
                }
            }
        }

        // ─────────────────────────────────────────
        // 12. TRIVY IMAGE SCAN
        //    image.tar est créé ICI, APRÈS le scan
        //    OWASP — plus aucun conflit possible
        // ─────────────────────────────────────────
        stage('Trivy Image Scan') {
            steps {
                dir('achat') {
                    bat '''
                    if not exist trivy-cache mkdir trivy-cache

                    docker save %FULL_IMAGE% -o image.tar

                    docker run --rm ^
                        -v "%cd%:/project" ^
                        -v trivy-cache:/root/.cache/ ^
                        aquasec/trivy image ^
                        --input /project/image.tar ^
                        --timeout 60m ^
                        --no-progress ^
                        --scanners vuln ^
                        --severity HIGH,CRITICAL ^
                        --skip-db-update
                    '''
                }
            }
        }

        // ─────────────────────────────────────────
        // 13. DOCKER COMPOSE
        // ─────────────────────────────────────────
        stage('Run Application with Docker Compose') {
            steps {
                dir('achat') {
                    bat '''
                    echo ==== STARTING STACK ====
                    docker compose down -v --remove-orphans || exit 0
                    docker compose --env-file .env up -d
                    docker ps
                    '''
                }
            }
        }

        // ─────────────────────────────────────────
        // 14. OWASP ZAP SCAN
        // ─────────────────────────────────────────
        stage('OWASP ZAP Scan') {
            steps {
                dir('achat') {
                    bat '''
                    if not exist reports mkdir reports

                    docker run --rm ^
                        -v "%cd%\\reports:/zap/wrk" ^
                        ghcr.io/zaproxy/zaproxy zap-baseline.py ^
                        -t http://host.docker.internal:8089/SpringMVC/operateur/retrieve-all-operateurs ^
                        -r zap-report.html ^
                        -I
                    '''
                }
            }
            post {
                always {
                    publishHTML(target: [
                        allowMissing         : true,
                        alwaysLinkToLastBuild: true,
                        keepAll              : true,
                        reportDir            : 'achat/reports',
                        reportFiles          : 'zap-report.html',
                        reportName           : 'OWASP ZAP Report'
                    ])
                }
            }
        }

        // ─────────────────────────────────────────
        // 15. MONITORING
        // ─────────────────────────────────────────
        stage('Check Monitoring') {
            steps {
                bat 'docker ps --filter "name=prometheus"'
                bat 'docker ps --filter "name=grafana"'
            }
        }
    }

    // ─────────────────────────────────────────────
    // POST
    // ─────────────────────────────────────────────
    post {
        success {
            echo '✅ Pipeline terminé avec succès.'
        }

        failure {
            echo '❌ Pipeline en échec.'
        }

        always {
            // Nettoyage de image.tar pour ne pas polluer
            // le prochain scan OWASP
            dir('achat') {
                bat 'if exist image.tar del /f image.tar'
            }

            archiveArtifacts artifacts         : 'achat/target/*.jar',
                             fingerprint       : true,
                             allowEmptyArchive : true

            junit allowEmptyResults : true,
                  testResults       : 'achat/target/surefire-reports/*.xml'
        }
    }
}