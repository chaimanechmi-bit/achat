pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timestamps()
    }

    environment {
        IMAGE_NAME = 'achat-app'
        IMAGE_TAG = 'latest'
        FULL_IMAGE = "achat-app:latest"
    }

    stages {

        stage('Checkout depuis Git') {
            steps {
                checkout scm
            }
        }

        // =========================
        // 🔐 ENV SECURE
        // =========================
        stage('Load ENV securely') {
            steps {
                dir('achat') {
                    withCredentials([file(credentialsId: 'achat-env', variable: 'ENV_FILE')]) {
                        bat '''
                        echo Loading .env from Jenkins credentials

                        if exist .env del .env
                        copy "%ENV_FILE%" .env
                        '''
                    }
                }
            }
        }

        stage('Verification du projet') {
            steps {
                dir('achat') {
                    bat 'dir'
                }
            }
        }

        stage('Build Maven') {
            steps {
                dir('achat') {
                    bat 'mvn clean compile'
                }
            }
        }

        stage('Tests avec JaCoCo') {
            steps {
                dir('achat') {
                    bat 'mvn test -DfailIfNoTests=false'
                }
            }
        }

        // =========================
        // 🔥 OWASP FIX FINAL (IMPORTANT)
        // =========================
        stage('OWASP Dependency Check') {
            steps {
                dir('achat') {
                    script {
                        def dcHome = tool 'owasp-dc'

                        bat """
                        if not exist reports mkdir reports

                        ${dcHome}\\bin\\dependency-check.bat ^
                        --project achat-app ^
                        --scan src ^
                        --scan pom.xml ^
                        --exclude image.tar ^
                        --format HTML ^
                        --out reports ^
                        --disableCentral ^
                        --noupdate ^
                        --nvdMaxRetryCount 2
                        """
                    }
                }
            }
        }

        stage('Analyse SonarQube') {
            steps {
                dir('achat') {
                    withSonarQubeEnv('SonarQube') {
                        bat '''
                        mvn sonar:sonar ^
                        -Dsonar.projectKey=achat ^
                        -Dsonar.projectName=achat
                        '''
                    }
                }
            }
        }

        stage('Package') {
            steps {
                dir('achat') {
                    bat 'mvn package -DskipTests'
                }
            }
        }

        stage('Trivy FS Scan') {
            steps {
                dir('achat') {
                    bat '''
                    docker run --rm ^
                    -v "%cd%:/project" ^
                    -v trivy-cache:/root/.cache/ ^
                    aquasec/trivy fs ^
                    --no-progress ^
                    --scanners vuln,secret ^
                    /project
                    '''
                }
            }
        }

        stage('Publish to Nexus') {
            steps {
                dir('achat') {
                    bat 'mvn deploy -DskipTests'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('achat') {
                    bat 'docker build -t %FULL_IMAGE% .'
                }
            }
        }

        stage('Trivy Image Scan') {
            steps {
                dir('achat') {
                    bat '''
                    docker save %FULL_IMAGE% -o image.tar

                    docker run --rm ^
                    -v "%cd%:/project" ^
                    -v trivy-cache:/root/.cache/ ^
                    aquasec/trivy image ^
                    --input /project/image.tar ^
                    --severity HIGH,CRITICAL ^
                    --no-progress
                    '''
                }
            }
        }

        // =========================
        // 🚀 RUN FIXED
        // =========================
        stage('Run Application with Docker Compose') {
            steps {
                dir('achat') {
                    bat '''
                    echo Starting stack...

                    docker compose down -v --remove-orphans || exit 0

                    docker compose --env-file .env up -d

                    docker ps
                    '''
                }
            }
        }

        stage('OWASP ZAP Scan') {
            steps {
                dir('achat') {
                    bat '''
                    if not exist reports mkdir reports

                    docker run --rm ^
                    -v "%cd%\\reports:/zap/wrk" ^
                    ghcr.io/zaproxy/zaproxy zap-baseline.py ^
                    -t http://host.docker.internal:8089/SpringMVC/operateur/retrieve-all-operateurs ^
                    -r zap-report.html ^
                    -I
                    '''
                }
            }
        }

        stage('Check Monitoring') {
            steps {
                bat 'docker ps --filter "name=prometheus"'
                bat 'docker ps --filter "name=grafana"'
            }
        }
    }

    post {
        success {
            echo 'SUCCESS'
        }

        failure {
            echo 'FAILED'
        }
    }
}