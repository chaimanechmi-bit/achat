pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timestamps()
    }

    environment {
        IMAGE_NAME = 'achat-app'
        IMAGE_TAG = 'latest'
        FULL_IMAGE = "achat-app:latest"
    }

    stages {

        stage('Checkout depuis Git') {
            steps {
                checkout scm
            }
        }

        stage('Verification du projet') {
            steps {
                bat 'dir'
                dir('achat') {
                    bat 'dir'
                }
            }
        }

        stage('Build Maven') {
            steps {
                dir('achat') {
                    bat 'mvn clean compile'
                }
            }
        }

        stage('Tests') {
            steps {
                dir('achat') {
                    bat 'mvn test -DfailIfNoTests=false'
                }
            }
        }

        // =========================
        // OWASP DEPENDENCY CHECK FIXED
        // =========================
        stage('OWASP Dependency Check') {
            steps {
                dir('achat') {
                    script {
                        def dcHome = tool 'owasp-dc'

                        bat """
                        if not exist security-reports\\dependency-check mkdir security-reports\\dependency-check

                        ${dcHome}\\bin\\dependency-check.bat ^
                        --project achat-app ^
                        --scan pom.xml ^
                        --format HTML ^
                        --out security-reports\\dependency-check ^
                        --disableCentral ^
                        --noupdate ^
                        --nvdMaxRetryCount 2
                        """
                    }
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('achat') {
                    withSonarQubeEnv('SonarQube') {
                        bat '''
                        mvn sonar:sonar ^
                        -Dsonar.projectKey=achat ^
                        -Dsonar.projectName=achat
                        '''
                    }
                }
            }
        }

        stage('Package') {
            steps {
                dir('achat') {
                    bat 'mvn package -DskipTests'
                }
            }
        }

        // =========================
        // TRIVY FS
        // =========================
        stage('Trivy FS Scan') {
            steps {
                dir('achat') {
                    bat '''
                    docker run --rm ^
                    -v "%cd%:/project" ^
                    aquasec/trivy fs ^
                    --no-progress ^
                    --scanners vuln,secret ^
                    /project
                    '''
                }
            }
        }

        stage('Publish to Nexus') {
            steps {
                dir('achat') {
                    configFileProvider([
                        configFile(
                            fileId: 'nexus-maven-settings',
                            variable: 'MAVEN_SETTINGS'
                        )
                    ]) {
                        bat 'mvn deploy -s %MAVEN_SETTINGS% -DskipTests'
                    }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('achat') {
                    bat 'docker build -t %FULL_IMAGE% .'
                }
            }
        }

        // =========================
        // TRIVY IMAGE (FIXED)
        // =========================
        stage('Trivy Image Scan') {
            steps {
                bat """
                docker run --rm ^
                aquasec/trivy image ^
                --no-progress ^
                --severity HIGH,CRITICAL ^
                %FULL_IMAGE%
                """
            }
        }

        stage('Run Application with Docker Compose') {
            steps {
                dir('achat') {
                    bat 'docker compose down --remove-orphans || exit 0'
                    bat 'docker compose up -d'
                    bat 'docker ps'
                }
            }
        }

        // =========================
        // OWASP ZAP FIXED
        // =========================
        stage('OWASP ZAP Scan') {
            steps {
                bat '''
                if not exist security-reports\\zap mkdir security-reports\\zap

                docker run --rm ^
                -v "%cd%\\security-reports\\zap:/zap/wrk" ^
                ghcr.io/zaproxy/zaproxy zap-baseline.py ^
                -t http://host.docker.internal:8089 ^
                -r zap-report.html ^
                -I
                '''
            }
        }

        stage('Check Monitoring') {
            steps {
                bat 'docker ps --filter "name=prometheus"'
                bat 'docker ps --filter "name=grafana"'
            }
        }
    }

    post {
        success {
            echo '✅ Pipeline DevSecOps OK'
        }

        failure {
            echo '❌ Pipeline FAILED'
        }

        always {
            archiveArtifacts artifacts: '''
                achat/target/*.jar,
                achat/security-reports/**/*
            ''', fingerprint: true

            junit allowEmptyResults: true,
                  testResults: 'achat/target/surefire-reports/*.xml'
        }
    }
}