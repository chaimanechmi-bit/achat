pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timestamps()
    }

    environment {
        IMAGE_NAME = 'achat-app'
        IMAGE_TAG = 'latest'
        FULL_IMAGE = "achat-app:latest"
    }

    stages {

        stage('Checkout depuis Git') {
            steps {
                checkout scm
            }
        }

        stage('Load ENV securely') {
            steps {
                dir('achat') {
                    withCredentials([file(credentialsId: 'achat-env', variable: 'ENV_FILE')]) {
                        bat '''
                        if exist .env del .env
                        copy "%ENV_FILE%" .env
                        '''
                    }
                }
            }
        }

        stage('Build Maven') {
            steps {
                dir('achat') {
                    bat 'mvn clean compile'
                }
            }
        }

        stage('Tests') {
            steps {
                dir('achat') {
                    bat 'mvn test -DfailIfNoTests=false'
                }
            }
        }

        // =========================
        // ✅ FIX OWASP DEPENDENCY CHECK (IMPORTANT)
        // =========================
        stage('OWASP Dependency Check') {
            steps {
                dir('achat') {
                    script {
                        def dcHome = tool 'owasp-dc'

                        bat """
                        if exist reports rmdir /s /q reports
                        mkdir reports

                        ${dcHome}\\bin\\dependency-check.bat ^
                        --project achat-app ^
                        --scan src ^
                        --scan pom.xml ^
                        --format HTML ^
                        --out reports ^
                        --disableArchive ^
                        --disableCentral ^
                        --noupdate ^
                        --nvdMaxRetryCount 2 ^
                        --suppression suppression.xml
                        """
                    }
                }
            }
        }

        stage('SonarQube') {
            steps {
                dir('achat') {
                    withSonarQubeEnv('SonarQube') {
                        bat '''
                        mvn sonar:sonar ^
                        -Dsonar.projectKey=achat
                        '''
                    }
                }
            }
        }

        stage('Package') {
            steps {
                dir('achat') {
                    bat 'mvn package -DskipTests'
                }
            }
        }

        stage('Trivy FS Scan') {
            steps {
                dir('achat') {
                    bat '''
                    docker run --rm ^
                    -v "%cd%:/project" ^
                    aquasec/trivy fs /project
                    '''
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('achat') {
                    bat 'docker build -t %FULL_IMAGE% .'
                }
            }
        }

        stage('Run App') {
            steps {
                dir('achat') {
                    bat '''
                    docker compose down -v --remove-orphans || exit 0
                    docker compose --env-file .env up -d
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline SUCCESS'
        }
        failure {
            echo 'Pipeline FAILED'
        }
    }
}