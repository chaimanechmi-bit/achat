pipeline {
    agent any

    environment {
        IMAGE_NAME = 'achat-app'
        IMAGE_TAG = 'latest'
        FULL_IMAGE = "achat-app:latest"
    }

    stages {

        // =========================
        // CHECKOUT
        // =========================
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        // =========================
        // BUILD
        // =========================
        stage('Clean & Compile') {
            steps {
                dir('achat') {
                    bat 'mvn clean compile'
                }
            }
        }

        stage('Test') {
            steps {
                dir('achat') {
                    bat 'mvn test'
                }
            }
        }

        // =========================
        // OWASP DEPENDENCY CHECK
        // =========================
        stage('OWASP Dependency Check') {
            steps {
                dir('achat') {
                    script {
                        def dcHome = tool 'owasp-dc'

                        bat """
                        if not exist reports mkdir reports

                        ${dcHome}\\bin\\dependency-check.bat ^
                        --project achat-app ^
                        --scan . ^
                        --format HTML ^
                        --out reports ^
                        --disableCentral ^
                        --noupdate ^
                        --nvdMaxRetryCount 2
                        """
                    }
                }
            }
        }

        // =========================
        // SONARQUBE
        // =========================
        stage('SonarQube Analysis') {
            steps {
                dir('achat') {
                    withSonarQubeEnv('SonarQube') {
                        bat 'mvn sonar:sonar'
                    }
                }
            }
        }

        // =========================
        // PACKAGE
        // =========================
        stage('Package') {
            steps {
                dir('achat') {
                    bat 'mvn package -DskipTests'
                }
            }
        }

        // =========================
        // TRIVY FS SCAN
        // =========================
        stage('Trivy FS Scan') {
            steps {
                dir('achat') {
                    bat '''
                    docker run --rm ^
                    -v "%cd%:/project" ^
                    aquasec/trivy fs ^
                    --no-progress ^
                    --scanners vuln,secret ^
                    /project
                    '''
                }
            }
        }

        // =========================
        // BUILD DOCKER IMAGE
        // =========================
        stage('Build Docker Image') {
            steps {
                dir('achat') {
                    bat 'docker build -t %FULL_IMAGE% .'
                }
            }
        }

        // =========================
        // FIXED TRIVY IMAGE SCAN (IMPORTANT)
        // =========================
        stage('Trivy Image Scan') {
            steps {
                dir('achat') {
                    bat '''
                    if not exist trivy-cache mkdir trivy-cache

                    docker save %FULL_IMAGE% -o image.tar

                    docker run --rm ^
                    -v "%cd%:/project" ^
                    -v "%cd%/trivy-cache:/root/.cache/" ^
                    aquasec/trivy image ^
                    --input /project/image.tar ^
                    --timeout 60m ^
                    --no-progress ^
                    --scanners vuln ^
                    --severity HIGH,CRITICAL ^
                    --skip-db-update
                    '''
                }
            }
        }

        // =========================
        // RUN STACK
        // =========================
        stage('Run Application & Stack') {
            steps {
                dir('achat') {
                    bat 'docker compose down -v --remove-orphans || exit 0'
                    bat 'docker compose up -d'
                    bat 'docker ps'
                }
            }
        }

        // =========================
        // OWASP ZAP
        // =========================
        stage('OWASP ZAP Scan') {
            steps {
                dir('achat') {
                    bat '''
                    if not exist reports mkdir reports

                    docker run --rm ^
                    -v "%cd%\\reports:/zap/wrk" ^
                    ghcr.io/zaproxy/zaproxy zap-baseline.py ^
                    -t http://host.docker.internal:8089 ^
                    -r zap-report.html ^
                    -I
                    '''
                }
            }
        }

        // =========================
        // MONITORING CHECK
        // =========================
        stage('Check Monitoring') {
            steps {
                bat 'docker ps --filter "name=prometheus"'
                bat 'docker ps --filter "name=grafana"'
            }
        }

        // =========================
        // NEXUS DEPLOY
        // =========================
        stage('Publish to Nexus') {
            steps {
                dir('achat') {
                    configFileProvider([
                        configFile(
                            fileId: '96c23311-fbc7-4aa0-a4c4-bc0686d66999',
                            variable: 'MAVEN_SETTINGS'
                        )
                    ]) {
                        bat 'mvn deploy -s %MAVEN_SETTINGS% -DskipTests'
                    }
                }
            }
        }

        // =========================
        // ARCHIVE
        // =========================
        stage('Archive Artifact') {
            steps {
                archiveArtifacts artifacts: 'achat/target/*.jar', fingerprint: true
            }
        }
    }

    post {
        success {
            echo '✅ Pipeline DevSecOps OK'
        }

        failure {
            echo '❌ Pipeline FAILED (Build / Security / Docker / Scan)'
        }

        always {
            junit allowEmptyResults: true,
                  testResults: 'achat/target/surefire-reports/*.xml'
        }
    }
}